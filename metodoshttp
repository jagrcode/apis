import requests

BASE = "https://jsonplaceholder.typicode.com/posts"

# GET
r = requests.get(f"{BASE}/1",timeout=10)
print ("GET 1:", r.status_code, r.json()["title"], r.json())

# GET
r = requests.get(BASE, params={"userId": "1"}, timeout=10)
print ("GET 1:", r.status_code, r.json(), r.json())
posts = r.json()

print(len(posts))

# POST: crear un recurso

nuevo = {"title": "Mi primer post", "body": "Aprendiendo APIs", "userId": 1}
r = requests.post(BASE, json=nuevo, timeout=10)
print("POST:", r.status_code, r.json())

# PUT: reemplazar un recurso completo
actualizado = {"id": 1, "title": "Título nuevo", "body": "Texto nuevo", "userId": 1}
r = requests.put(f"{BASE}/1", json=actualizado, timeout=10)
print("PUT", r.status_code, r.json())


# PATCH: modificar solo un campo
r = requests.patch(f"{BASE}/1", json={"title": "Solo cambio el título"}, timeout=10)
print("PATCH", r.status_code, r.json())

# DELETE: eliminar un recurso
r = requests.delete(f"{BASE}/1", timeout=10)
print("DELETE", r.status_code)