{
  "openapi": "3.1.0",
  "info": {
    "title": "API de tareas",
    "description": "\nAPI de práctica para gestionar tareas.\n\n## Autenticación\n1. Envía usuario y contraseña a `POST /login`.\n2. Usa el `access_token` recibido en el header `Authorization: Bearer <token>`.\n\n## Roles\n* **admin**: puede crear, modificar y eliminar tareas.\n* **lector**: puede consultar, pero no eliminar.\n\nLas rutas de lectura son públicas.\n",
    "contact": {
      "name": "Jaime"
    },
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Iniciar sesión",
        "description": "Devuelve un token de acceso que vence a los 30 minutos.",
        "operationId": "login_login_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_login_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tareas": {
      "get": {
        "tags": [
          "tareas"
        ],
        "summary": "Listar",
        "operationId": "listar_tareas_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Máximo de tareas a devolver",
              "default": 10,
              "title": "Limit"
            },
            "description": "Máximo de tareas a devolver"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Cuántas tareas saltar",
              "default": 0,
              "title": "Offset"
            },
            "description": "Cuántas tareas saltar"
          },
          {
            "name": "hecha",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por estado",
              "title": "Hecha"
            },
            "description": "Filtrar por estado"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tarea"
                  },
                  "title": "Response Listar Tareas Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "tareas"
        ],
        "summary": "Crear",
        "operationId": "crear_tareas_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TareaCrear"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tarea"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tareas/resumen": {
      "get": {
        "tags": [
          "tareas"
        ],
        "summary": "Resumen de tareas",
        "description": "Cuenta las tareas totales, hechas y pendientes.",
        "operationId": "resumen_tareas_resumen_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resumen"
                }
              }
            }
          }
        }
      }
    },
    "/tareas/{tarea_id}": {
      "get": {
        "tags": [
          "tareas"
        ],
        "summary": "Obtener",
        "operationId": "obtener_tareas__tarea_id__get",
        "parameters": [
          {
            "name": "tarea_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tarea Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tarea"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "tareas"
        ],
        "summary": "Reemplazar",
        "operationId": "reemplazar_tareas__tarea_id__put",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "tarea_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tarea Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TareaCrear"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tarea"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "tareas"
        ],
        "summary": "Eliminar una tarea",
        "description": "Elimina una tarea. **Solo el rol `admin`.**",
        "operationId": "eliminar_tareas__tarea_id__delete",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "tarea_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tarea Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Token ausente, inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "El rol no tiene permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "La tarea no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_login_login_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
