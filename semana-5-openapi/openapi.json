        "title": "Resumen"
      },
      "Tarea": {
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Titulo",
            "description": "Texto corto de la tarea",
            "examples": [
              "Estudiar OpenAPI"
            ]
          },
